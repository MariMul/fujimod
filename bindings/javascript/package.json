{
  "name": "fujimod",
  "version": "0.1.0",
  "private": true,
  "description": "FujiMod asynchronous camera tools for JavaScript and WebUSB",
  "files": [
    "dist",
    "pkg",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./simulation/webgl2": {
      "types": "./pkg/simulation/webgl2/fujimod_simulation.d.ts",
      "import": "./pkg/simulation/webgl2/fujimod_simulation.js"
    },
    "./simulation/webgpu": {
      "types": "./pkg/simulation/webgpu/fujimod_simulation.d.ts",
      "import": "./pkg/simulation/webgpu/fujimod_simulation.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.ts && tsc",
    "test": "node scripts/build.ts --testing && tsc && tsc -p tsconfig.types.json && tsc -p tsconfig.testing.json && tsc -p tsconfig.scripts.json && node --test tests/usb.test.ts && node scripts/build.ts && tsc && tsc -p tsconfig.types.json && tsc -p tsconfig.scripts.json && node --test tests/production.ts tests/ownership.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.types.json && tsc -p tsconfig.scripts.json",
    "test:browser": "npm run build && node tests/browser.ts",
    "test:pyodide": "node ../python/tests/pyodide.ts",
    "test:pyodide:browser": "node ../python/tests/pyodide.ts && node ../python/tests/pyodide-browser.ts",
    "setup:tooling": "node scripts/install-tooling.ts"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "pyodide": "^314.0.7",
    "typescript": "^7.0.2"
  }
}
