{
  "$defs": {
    "AddressIdentity": {
      "additionalProperties": false,
      "description": "An identified firmware address range without its contents.",
      "properties": {
        "address": {
          "description": "Start address.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "description": "SHA-256 of the range.",
          "type": "string"
        },
        "size": {
          "description": "Byte length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "CalibrationInterval": {
      "additionalProperties": false,
      "description": "Bounds stored as little-endian 16-bit values in firmware configuration.",
      "properties": {
        "lower": {
          "description": "Byte offset of the lower bound from the configuration base.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "upper": {
          "description": "Byte offset of the upper bound from the configuration base.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "type": "object"
    },
    "ControlAction": {
      "additionalProperties": false,
      "description": "A logical action expressed through named keys.",
      "properties": {
        "keys": {
          "description": "Logical keys selected by the action.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "keys"
      ],
      "type": "object"
    },
    "ControlInput": {
      "description": "An electrical predicate referencing physical body wiring by identity.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Analog input with bounds obtained from firmware configuration.",
          "properties": {
            "callback": {
              "description": "Firmware callback that evaluates this input, when present.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "connection_id": {
              "description": "Body connection carrying this analog input.",
              "type": "string"
            },
            "event": {
              "description": "Firmware key-event number associated with the record.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "expected_result": {
              "description": "Callback result accepted as active, when present.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "intervals": {
              "description": "Calibration-table intervals accepted by this predicate.",
              "items": {
                "$ref": "#/$defs/CalibrationInterval"
              },
              "type": "array"
            },
            "kind": {
              "const": "adc",
              "type": "string"
            },
            "scanner_index": {
              "description": "Scanner record index within the firmware scanner table.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "connection_id",
            "intervals",
            "scanner_index",
            "event"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Digital input compared with a firmware-selected level.",
          "properties": {
            "connection_id": {
              "description": "Body connection carrying this digital input.",
              "type": "string"
            },
            "event": {
              "description": "Firmware key-event number associated with the record.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "expected_level": {
              "description": "Logic level interpreted as the selected key.",
              "type": "boolean"
            },
            "kind": {
              "const": "gpio",
              "type": "string"
            },
            "scanner": {
              "$ref": "#/$defs/GpioScanner",
              "description": "Scanner predicate used to interpret the digital input."
            },
            "scanner_index": {
              "description": "Scanner record index within the firmware scanner table.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "connection_id",
            "expected_level",
            "scanner",
            "scanner_index",
            "event"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Firmware quadrature decoder attached to a physical encoder.",
          "properties": {
            "connection_id": {
              "description": "Body connection carrying the encoder phases.",
              "type": "string"
            },
            "event": {
              "description": "Decoder event selected by this logical key.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "guard": {
              "description": "Firmware decoder guard address.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "gpio_quadrature",
              "type": "string"
            },
            "phase_map": {
              "description": "Decoder phase mapping.",
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            "reset": {
              "description": "Decoder reset counters and phase state.",
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            "threshold": {
              "description": "Decoder activation threshold.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "transitions": {
              "description": "Decoder transition values.",
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 16,
              "minItems": 16,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "connection_id",
            "phase_map",
            "transitions",
            "reset",
            "event",
            "guard",
            "threshold"
          ],
          "type": "object"
        }
      ]
    },
    "ControlInterface": {
      "description": "Firmware interpretation of a control outside the key scanner.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Power switch sampled through a physical GPIO and serial status field.",
          "properties": {
            "connection_id": {
              "description": "Body connection carrying the switch input.",
              "type": "string"
            },
            "endpoint": {
              "description": "Firmware serial endpoint selector.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "power_switch",
              "type": "string"
            },
            "mask": {
              "description": "Mask of status bits interpreted by the firmware.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "off_value": {
              "description": "Masked status value interpreted as off.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "on_value": {
              "description": "Masked status value interpreted as on.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "register": {
              "description": "Firmware-selected status register.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "saved_inputs": {
              "description": "Firmware address retaining sampled GPIO state.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "connection_id",
            "saved_inputs",
            "endpoint",
            "register",
            "mask",
            "on_value",
            "off_value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Touch reports read through a prefixed control-bus endpoint.",
          "properties": {
            "connection_id": {
              "description": "Body connection carrying control-bus traffic.",
              "type": "string"
            },
            "contacts": {
              "description": "Maximum simultaneous contacts decoded by the firmware.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "coordinate_bits": {
              "description": "Number of encoded coordinate bits.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "height": {
              "description": "Firmware logical coordinate height.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "irq": {
              "description": "Firmware interrupt line selected for reports.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "irq_mode": {
              "description": "Firmware-selected interrupt mode.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "prefixed_touch",
              "type": "string"
            },
            "mode": {
              "description": "Firmware control-bus transaction mode.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "offset_tags": {
              "description": "Configuration-byte offsets for logical coordinate correction.",
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "priority": {
              "description": "Firmware-selected interrupt priority.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "register": {
              "description": "First report register read by the firmware.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "report_bytes": {
              "description": "Report byte count consumed by the firmware.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "width": {
              "description": "Firmware logical coordinate width.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "connection_id",
            "mode",
            "register",
            "report_bytes",
            "contacts",
            "coordinate_bits",
            "width",
            "height",
            "offset_tags",
            "irq",
            "priority",
            "irq_mode"
          ],
          "type": "object"
        }
      ]
    },
    "ControlReaders": {
      "additionalProperties": false,
      "description": "Firmware routines used to read calibration and stable scanner state.",
      "properties": {
        "calibration": {
          "description": "Routine reading 16-bit control calibration values.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scanner": {
          "$ref": "#/$defs/ScannerReader",
          "description": "Routine reading stable key scanner state."
        }
      },
      "required": [
        "calibration",
        "scanner"
      ],
      "type": "object"
    },
    "FirmwareControl": {
      "additionalProperties": false,
      "description": "A firmware mapping for one physical control.",
      "properties": {
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/ControlAction"
          },
          "description": "Named logical actions and their required keys.",
          "type": "object"
        },
        "input": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/ControlInput"
            },
            "type": "array"
          },
          "description": "Electrical predicates keyed by logical key identity.",
          "type": [
            "object",
            "null"
          ]
        },
        "interface": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlInterface"
            },
            {
              "type": "null"
            }
          ],
          "description": "Firmware protocol interface for controls outside the key scanner."
        },
        "keys": {
          "description": "Logical key identities emitted by this control.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "positions": {
          "description": "Firmware key combinations for named positions.",
          "items": {
            "$ref": "#/$defs/FirmwareControlPosition"
          },
          "type": "array"
        },
        "unavailable_reason": {
          "description": "Reason no electronic mapping is established, when applicable.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "keys",
        "actions",
        "positions"
      ],
      "type": "object"
    },
    "FirmwareControlPosition": {
      "additionalProperties": false,
      "description": "Firmware key selection for a named control position.",
      "properties": {
        "active": {
          "description": "Whether this position asserts the associated binary control.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "keys": {
          "description": "Logical keys selecting this position.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "position": {
          "description": "Position identity or printed value.",
          "type": "string"
        }
      },
      "required": [
        "position",
        "keys"
      ],
      "type": "object"
    },
    "GpioScanner": {
      "description": "Firmware scanner predicates used for digital keys.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Direct GPIO comparison using the declared expected logic level.",
          "properties": {
            "kind": {
              "const": "direct",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Combined scanner predicate with its firmware-selected source and bounds.",
          "properties": {
            "kind": {
              "const": "combined",
              "type": "string"
            },
            "lower": {
              "description": "Lower comparison operand.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "source": {
              "description": "Scanner source selector.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "upper": {
              "description": "Upper comparison operand.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "source",
            "lower",
            "upper"
          ],
          "type": "object"
        }
      ]
    },
    "NativeKeyName": {
      "additionalProperties": false,
      "description": "One named native firmware event.",
      "properties": {
        "event": {
          "description": "Numeric event identity.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Native event name.",
          "type": "string"
        },
        "string_address": {
          "description": "Address of the native name string.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "event",
        "name",
        "string_address"
      ],
      "type": "object"
    },
    "NativeKeyNames": {
      "additionalProperties": false,
      "description": "Native firmware event names and the identity of their source table.",
      "properties": {
        "reader": {
          "description": "Routine used to read the table.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "description": "Native event names and their numeric identities.",
          "items": {
            "$ref": "#/$defs/NativeKeyName"
          },
          "type": "array"
        },
        "sha256": {
          "description": "SHA-256 of the table.",
          "type": "string"
        },
        "size": {
          "description": "Table byte length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rows",
        "reader",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "ScannerReader": {
      "additionalProperties": false,
      "description": "A firmware scanner state reader.",
      "properties": {
        "routine": {
          "$ref": "#/$defs/AddressIdentity",
          "description": "Reader routine identity."
        },
        "stable_offset": {
          "description": "Stable-state field offset within a scanner record.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "stable_offset",
        "routine"
      ],
      "type": "object"
    },
    "ScannerTable": {
      "additionalProperties": false,
      "description": "A firmware table used to scan physical input predicates.",
      "properties": {
        "base": {
          "description": "Table base address.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "count": {
          "description": "Number of scanner records.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "lookup": {
          "description": "Routine that looks up scanner entries.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "description": "SHA-256 of the scanner table.",
          "type": "string"
        },
        "stride": {
          "description": "Scanner record size in bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "base",
        "count",
        "stride",
        "lookup",
        "sha256"
      ],
      "type": "object"
    }
  },
  "$id": "https://fujimod.com/schemas/remote-controls.generated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Firmware key scanning and logical control mappings.",
  "properties": {
    "controls": {
      "additionalProperties": {
        "$ref": "#/$defs/FirmwareControl"
      },
      "description": "Logical behavior keyed by physical body control identity.",
      "type": "object"
    },
    "debug_keys_available": {
      "description": "Whether named debug key events are available.",
      "type": "boolean"
    },
    "input_readers": {
      "$ref": "#/$defs/ControlReaders",
      "description": "Firmware calibration and scanner readers."
    },
    "native_key_names": {
      "$ref": "#/$defs/NativeKeyNames",
      "description": "Firmware native event names and their table identity."
    },
    "scanner": {
      "$ref": "#/$defs/ScannerTable",
      "description": "Firmware scanner table identity and extent."
    }
  },
  "required": [
    "controls",
    "debug_keys_available",
    "input_readers",
    "scanner",
    "native_key_names"
  ],
  "title": "FirmwareControls",
  "type": "object"
}
