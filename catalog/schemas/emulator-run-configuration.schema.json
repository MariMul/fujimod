{
  "$defs": {
    "GeneratedSceneAsset": {
      "additionalProperties": false,
      "description": "A generated run-scene input asset.",
      "properties": {
        "id": {
          "description": "Stable asset identity scoped to the configuration.",
          "type": "string"
        },
        "pattern": {
          "description": "Repeated bytes used to generate the asset.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "size": {
          "description": "Generated byte length.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "pattern",
        "size"
      ],
      "type": "object"
    },
    "RunAdcInputs": {
      "additionalProperties": false,
      "description": "ADC block and reset sample vector.",
      "properties": {
        "block_id": {
          "description": "SoC ADC block identity.",
          "type": "string"
        },
        "samples": {
          "description": "Per-channel samples at reset.",
          "items": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "block_id",
        "samples"
      ],
      "type": "object"
    },
    "RunCardInput": {
      "additionalProperties": false,
      "description": "Initial removable-card state.",
      "properties": {
        "connection_id": {
          "description": "Body connection identity for the removable-card slot.",
          "type": "string"
        },
        "present": {
          "description": "Whether a card is inserted.",
          "type": "boolean"
        },
        "write_protected": {
          "description": "Whether an inserted card is write protected.",
          "type": "boolean"
        }
      },
      "required": [
        "connection_id",
        "present",
        "write_protected"
      ],
      "type": "object"
    },
    "RunConnectionState": {
      "additionalProperties": false,
      "description": "Initial state of a physical body connection.",
      "properties": {
        "connected": {
          "description": "Whether the external connection is present or electrically closed.",
          "type": "boolean"
        },
        "connection_id": {
          "description": "Body connection identity.",
          "type": "string"
        }
      },
      "required": [
        "connection_id",
        "connected"
      ],
      "type": "object"
    },
    "RunEngine": {
      "description": "A supported processor execution backend.",
      "oneOf": [
        {
          "const": "unicorn",
          "description": "Run the configured processors through the Unicorn backend.",
          "type": "string"
        }
      ]
    },
    "RunExecution": {
      "additionalProperties": false,
      "description": "Execution policy selected by the run configuration.",
      "properties": {
        "engine": {
          "$ref": "#/$defs/RunEngine",
          "description": "CPU engine selected for the configured processors."
        },
        "instructions_per_tick": {
          "$ref": "#/$defs/RunInstructionRate",
          "description": "Instruction-derived virtual-time ratio."
        },
        "mode": {
          "$ref": "#/$defs/RunExecutionMode",
          "description": "Strictly model unsupported hardware and bus behavior."
        },
        "quantum": {
          "description": "Maximum instruction count scheduled in one batch.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "engine",
        "quantum",
        "instructions_per_tick"
      ],
      "type": "object"
    },
    "RunExecutionMode": {
      "description": "A supported run execution mode.",
      "oneOf": [
        {
          "const": "strict",
          "description": "Refuse unsupported hardware or bus behavior.",
          "type": "string"
        }
      ]
    },
    "RunFirstStart": {
      "additionalProperties": false,
      "description": "Run policy for one logical key used to accept the first-start prompt.",
      "properties": {
        "hold_ticks": {
          "description": "Virtual ticks to hold the input active.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "key_id": {
          "description": "Firmware logical key identity, such as `EXE_M`.",
          "type": "string"
        },
        "max_presses": {
          "description": "Maximum input presses accepted for this startup policy.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "settle_ticks": {
          "description": "Virtual ticks to wait after releasing the input.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "key_id",
        "hold_ticks",
        "settle_ticks",
        "max_presses"
      ],
      "type": "object"
    },
    "RunGpioInputs": {
      "additionalProperties": false,
      "description": "GPIO input block and semantic external states for the base run.",
      "properties": {
        "block_id": {
          "description": "SoC GPIO block identity.",
          "type": "string"
        },
        "connections": {
          "description": "External connection states resolved through body wiring.",
          "items": {
            "$ref": "#/$defs/RunConnectionState"
          },
          "type": "array"
        },
        "keys": {
          "description": "Explicit key/control states; released controls are listed as false.",
          "items": {
            "$ref": "#/$defs/RunKeyState"
          },
          "type": "array"
        }
      },
      "required": [
        "block_id",
        "keys",
        "connections"
      ],
      "type": "object"
    },
    "RunImage": {
      "additionalProperties": false,
      "description": "A live-view image source and its raster layout.",
      "properties": {
        "asset": {
          "description": "Generated scene asset identity.",
          "type": "string"
        },
        "height": {
          "description": "Raster height in pixels.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "stride": {
          "description": "Raster row stride in bytes.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Raster width in pixels.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "stride",
        "asset"
      ],
      "type": "object"
    },
    "RunImages": {
      "additionalProperties": false,
      "description": "The named image sources used by the run scene.",
      "properties": {
        "live_image": {
          "$ref": "#/$defs/RunImage",
          "description": "Live-view image and raster layout."
        }
      },
      "required": [
        "live_image"
      ],
      "type": "object"
    },
    "RunInputs": {
      "additionalProperties": false,
      "description": "Synthetic starting input values applied to resolved blocks and parts.",
      "properties": {
        "adc": {
          "$ref": "#/$defs/RunAdcInputs",
          "description": "ADC reset samples."
        },
        "card": {
          "$ref": "#/$defs/RunCardInput",
          "description": "Initial SD card insertion and protection state."
        },
        "first_start": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunFirstStart"
            },
            {
              "type": "null"
            }
          ],
          "description": "Policy for accepting a firmware first-start prompt, when needed."
        },
        "gpio": {
          "$ref": "#/$defs/RunGpioInputs",
          "description": "GPIO reset state and explicitly released controls."
        },
        "mcu": {
          "$ref": "#/$defs/RunMcuInput",
          "description": "MCU persistent input and RTC start state."
        },
        "power": {
          "$ref": "#/$defs/RunPowerInput",
          "description": "Power-controller reset input."
        },
        "serial_registers": {
          "description": "Other declared reset values for serial-backed parts.",
          "items": {
            "$ref": "#/$defs/RunSerialRegisters"
          },
          "type": "array"
        },
        "usb": {
          "$ref": "#/$defs/RunUsbInput",
          "description": "Initial USB cable state."
        }
      },
      "required": [
        "gpio",
        "adc",
        "power",
        "mcu",
        "serial_registers",
        "usb",
        "card"
      ],
      "type": "object"
    },
    "RunInstructionRate": {
      "additionalProperties": false,
      "description": "Closed instruction-derived timebase ratio for a run.",
      "properties": {
        "denominator": {
          "description": "Board ticks advanced per instruction entry.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "numerator": {
          "description": "Instruction entries consumed per board tick.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "type": "object"
    },
    "RunKeyState": {
      "additionalProperties": false,
      "description": "Initial state of a physical key or body control connection.",
      "properties": {
        "connection_id": {
          "description": "Body connection identity for the control.",
          "type": "string"
        },
        "pressed": {
          "description": "Whether the control is pressed at reset.",
          "type": "boolean"
        }
      },
      "required": [
        "connection_id",
        "pressed"
      ],
      "type": "object"
    },
    "RunMcuInput": {
      "additionalProperties": false,
      "description": "MCU packet, serial clock and RTC start state.",
      "properties": {
        "packet": {
          "description": "Synthetic sixteen-byte persistent settings packet.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        },
        "part_id": {
          "description": "Body MCU-interface part identity.",
          "type": "string"
        },
        "rtc": {
          "$ref": "#/$defs/RunRtcInput",
          "description": "Synthetic RTC state at reset."
        }
      },
      "required": [
        "part_id",
        "packet",
        "rtc"
      ],
      "type": "object"
    },
    "RunPowerInput": {
      "additionalProperties": false,
      "description": "Power-controller reset values.",
      "properties": {
        "boot_reply": {
          "description": "Synthetic boot reply byte.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "part_id": {
          "description": "Body power-controller part identity.",
          "type": "string"
        },
        "powered_on": {
          "description": "Whether the camera power input is asserted.",
          "type": "boolean"
        },
        "spi_status": {
          "description": "Synthetic serial status values presented by the power controller.",
          "items": {
            "$ref": "#/$defs/RunRegisterValue"
          },
          "type": "array"
        }
      },
      "required": [
        "part_id",
        "powered_on",
        "boot_reply",
        "spi_status"
      ],
      "type": "object"
    },
    "RunRegisterValue": {
      "additionalProperties": false,
      "description": "One synthetic external serial register value.",
      "properties": {
        "register": {
          "description": "External part register number.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "description": "Initial register byte.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "register",
        "value"
      ],
      "type": "object"
    },
    "RunRtcInput": {
      "additionalProperties": false,
      "description": "RTC values supplied at the start of a run.",
      "properties": {
        "initial_seconds": {
          "description": "Initial seconds in the device clock's declared epoch.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maximum_seconds": {
          "description": "Maximum supported seconds in the device clock's epoch.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "started": {
          "description": "Starting virtual tick for RTC progression.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "ticks_per_second": {
          "description": "Virtual ticks per RTC second.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "initial_seconds",
        "ticks_per_second",
        "maximum_seconds",
        "started"
      ],
      "type": "object"
    },
    "RunScene": {
      "additionalProperties": false,
      "description": "Generated scene assets and the devices that consume them.",
      "properties": {
        "frame_period_ticks": {
          "description": "Initial frame clock period in virtual ticks.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "generated_assets": {
          "description": "Deterministic external byte assets generated from fixed patterns.",
          "items": {
            "$ref": "#/$defs/GeneratedSceneAsset"
          },
          "type": "array"
        },
        "images": {
          "$ref": "#/$defs/RunImages",
          "description": "Image input presented to live-view hardware."
        },
        "statistics": {
          "$ref": "#/$defs/RunStatistics",
          "description": "Statistics input presented to live-view hardware."
        }
      },
      "required": [
        "generated_assets",
        "images",
        "statistics",
        "frame_period_ticks"
      ],
      "type": "object"
    },
    "RunSerialRegisters": {
      "additionalProperties": false,
      "description": "Initial serial-register values for one resolved physical part.",
      "properties": {
        "part_id": {
          "description": "Body part identity whose external registers receive these values.",
          "type": "string"
        },
        "values": {
          "description": "Register values at reset.",
          "items": {
            "$ref": "#/$defs/RunRegisterValue"
          },
          "type": "array"
        }
      },
      "required": [
        "part_id",
        "values"
      ],
      "type": "object"
    },
    "RunStart": {
      "description": "A supported firmware start entry.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Reset through the selected firmware's real boot ROM.",
          "properties": {
            "kind": {
              "const": "rom",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Enter through the selected firmware's loader entry.",
          "properties": {
            "kind": {
              "const": "loader",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "RunStatistics": {
      "additionalProperties": false,
      "description": "The named statistics sources used by the run scene.",
      "properties": {
        "live_statistics": {
          "description": "Statistics spans presented to live-view hardware.",
          "items": {
            "$ref": "#/$defs/RunStatisticsSpan"
          },
          "type": "array"
        }
      },
      "required": [
        "live_statistics"
      ],
      "type": "object"
    },
    "RunStatisticsSpan": {
      "additionalProperties": false,
      "description": "One statistics asset span.",
      "properties": {
        "asset": {
          "description": "Generated scene asset identity.",
          "type": "string"
        },
        "destination": {
          "description": "Statistics destination selected by the device implementation.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "description": "Byte offset within the destination.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "destination",
        "offset",
        "asset"
      ],
      "type": "object"
    },
    "RunUsbInput": {
      "additionalProperties": false,
      "description": "Initial USB cable state.",
      "properties": {
        "connected": {
          "description": "Whether a USB cable is present.",
          "type": "boolean"
        },
        "connection_id": {
          "description": "Body USB connection identity.",
          "type": "string"
        }
      },
      "required": [
        "connection_id",
        "connected"
      ],
      "type": "object"
    }
  },
  "$id": "https://fujimod.com/schemas/emulator-run-configuration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A validated, named run configuration for one resolved body and firmware.",
  "properties": {
    "$schema": {
      "const": "https://fujimod.com/schemas/emulator-run-configuration.schema.json",
      "description": "Stable schema identifier for this document.",
      "type": "string"
    },
    "body_id": {
      "description": "Selected body identity.",
      "type": "string"
    },
    "execution": {
      "$ref": "#/$defs/RunExecution",
      "description": "Execution policy for this run."
    },
    "firmware_id": {
      "description": "Selected firmware identity.",
      "type": "string"
    },
    "id": {
      "description": "Stable run-configuration identity.",
      "type": "string"
    },
    "inputs": {
      "$ref": "#/$defs/RunInputs",
      "description": "Declared synthetic reset inputs, addressed by catalog identity."
    },
    "overlays": {
      "description": "Named overlays to apply in declaration order.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "scene": {
      "$ref": "#/$defs/RunScene",
      "description": "External scene inputs generated for this run."
    },
    "schema": {
      "description": "Run-configuration document version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "start": {
      "$ref": "#/$defs/RunStart",
      "description": "Firmware entry mode selected for this run."
    }
  },
  "required": [
    "$schema",
    "schema",
    "id",
    "body_id",
    "firmware_id",
    "start",
    "execution",
    "inputs",
    "scene",
    "overlays"
  ],
  "title": "RunConfiguration",
  "type": "object"
}
