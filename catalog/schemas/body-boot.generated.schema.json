{
  "$defs": {
    "BootCard": {
      "enum": [
        "service_boot",
        "firmware_update",
        "not_required",
        "unspecified"
      ],
      "type": "string"
    },
    "BootEffect": {
      "description": "Program capabilities or known lifecycle effects.",
      "enum": [
        "firmware_write",
        "service_commands",
        "card_program_defined",
        "settings_reset_on_exit"
      ],
      "type": "string"
    },
    "BootEntry": {
      "additionalProperties": false,
      "description": "Physical entry conditions; no host command sequence is encoded here.",
      "properties": {
        "card": {
          "$ref": "#/$defs/BootCard",
          "description": "Card contents required by the procedure."
        },
        "hold": {
          "description": "Simultaneously held controls when powering on.",
          "items": {
            "$ref": "#/$defs/BootKey"
          },
          "type": "array"
        },
        "instructions": {
          "description": "Existing ordered guide text, when the published guide has additional steps.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "release_when": {
          "description": "Observable condition for releasing the held controls, when specified.",
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "description": "Card slot when specified, numbered from one.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "usb": {
          "$ref": "#/$defs/BootUsb",
          "description": "USB condition at entry."
        }
      },
      "required": [
        "usb",
        "card",
        "hold",
        "instructions"
      ],
      "type": "object"
    },
    "BootGroup": {
      "description": "Top-level startup groups.",
      "enum": [
        "service",
        "firmware_update",
        "sd_boot"
      ],
      "type": "string"
    },
    "BootKey": {
      "additionalProperties": false,
      "description": "One held control with an explicit physical action.",
      "properties": {
        "action": {
          "$ref": "#/$defs/BootKeyAction",
          "description": "Press or directional action; a label is never parsed to infer this."
        },
        "control_id": {
          "description": "Canonical physical-control identity, when resolved unambiguously.",
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "description": "Human-readable control name.",
          "type": "string"
        }
      },
      "required": [
        "label",
        "action"
      ],
      "type": "object"
    },
    "BootKeyAction": {
      "enum": [
        "press",
        "full_press",
        "up"
      ],
      "type": "string"
    },
    "BootOption": {
      "additionalProperties": false,
      "description": "One startup option; describing it does not enable a camera operation.",
      "properties": {
        "effects": {
          "description": "Actions the selected program can perform, not consequences of every key press.",
          "items": {
            "$ref": "#/$defs/BootEffect"
          },
          "type": "array"
        },
        "entry": {
          "$ref": "#/$defs/BootEntry",
          "description": "Controls and connection/card conditions at power-on."
        },
        "group": {
          "$ref": "#/$defs/BootGroup",
          "description": "Related startup options shown together by a caller."
        },
        "label": {
          "description": "Human-readable name.",
          "type": "string"
        },
        "models": {
          "description": "Exact model names covered; shared bodies do not imply sibling support.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "notes": {
          "description": "Details relevant to this option.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "purpose": {
          "$ref": "#/$defs/BootPurpose",
          "description": "Program or session selected by this procedure."
        },
        "status": {
          "$ref": "#/$defs/BootStatus",
          "description": "Whether the instruction is documented, implemented, provisional, or superseded."
        }
      },
      "required": [
        "label",
        "group",
        "purpose",
        "models",
        "status",
        "entry",
        "effects",
        "notes"
      ],
      "type": "object"
    },
    "BootPurpose": {
      "description": "Distinct purposes which may share the same startup controls.",
      "enum": [
        "service_session",
        "firmware_update",
        "firmware_download",
        "card_program",
        "entry_probe"
      ],
      "type": "string"
    },
    "BootStatus": {
      "description": "Instruction status; candidates and superseded instructions are not active procedures.",
      "enum": [
        "documented",
        "implemented",
        "candidate",
        "superseded"
      ],
      "type": "string"
    },
    "BootUsb": {
      "enum": [
        "connected",
        "not_used",
        "unspecified"
      ],
      "type": "string"
    }
  },
  "$id": "https://fujimod.com/schemas/body-boot.generated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hand-maintained startup options for a body, including model-specific variants.",
  "properties": {
    "$schema": {
      "const": "https://fujimod.com/schemas/body-boot.generated.schema.json",
      "description": "Stable schema identifier for this document.",
      "type": "string"
    },
    "body_id": {
      "description": "Body identity; a hardware definition is not required.",
      "type": "string"
    },
    "boot_options": {
      "additionalProperties": {
        "$ref": "#/$defs/BootOption"
      },
      "description": "Startup options keyed by identity, grouped for callers.",
      "type": "object"
    },
    "models": {
      "description": "Camera model names reviewed in this document.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "notes": {
      "description": "Body-specific coverage or interpretation notes.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "description": "Document format version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "$schema",
    "schema",
    "body_id",
    "models",
    "boot_options",
    "notes"
  ],
  "title": "BodyBootOptions",
  "type": "object"
}
