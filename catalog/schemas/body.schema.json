{
  "$defs": {
    "AperturePosition": {
      "additionalProperties": false,
      "description": "An aperture mechanism position and f-number.",
      "properties": {
        "f_number": {
          "description": "Optical f-number at this position.",
          "format": "double",
          "type": "number"
        },
        "position": {
          "description": "Mechanical position value.",
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "position",
        "f_number"
      ],
      "type": "object"
    },
    "BlockSignal": {
      "description": "Named control signals carried by SoC blocks.",
      "oneOf": [
        {
          "const": "detect",
          "description": "Presence or cable-detect signal.",
          "type": "string"
        },
        {
          "const": "write_protect",
          "description": "Write-protect signal.",
          "type": "string"
        },
        {
          "const": "data_ready",
          "description": "Data ready signal.",
          "type": "string"
        },
        {
          "const": "clock",
          "description": "Clock output.",
          "type": "string"
        }
      ]
    },
    "BodyConnection": {
      "additionalProperties": false,
      "description": "A physical body connection.",
      "properties": {
        "id": {
          "description": "Connection identity referenced by body wiring and run inputs.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ConnectionKind",
          "description": "Physical connection category."
        },
        "signals": {
          "description": "Electrical or physical signals carried by the connection.",
          "items": {
            "$ref": "#/$defs/ConnectionSignal"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "signals"
      ],
      "type": "object"
    },
    "BodyControl": {
      "additionalProperties": false,
      "description": "A physical control's identity, positions, and body connections.",
      "properties": {
        "assignable": {
          "description": "Whether firmware allows its function to be assigned.",
          "type": "boolean"
        },
        "connection_ids": {
          "description": "Physical body connections used by this control.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "default_function": {
          "description": "Documented default function when available.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ControlKind",
          "description": "Mechanical control category."
        },
        "location": {
          "$ref": "#/$defs/ControlLocation",
          "description": "Physical position on the camera body."
        },
        "manual_page": {
          "description": "Relevant manual page when available.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "Printed or documented control name.",
          "type": "string"
        },
        "positions": {
          "description": "Documented mechanical positions.",
          "items": {
            "$ref": "#/$defs/ControlPosition"
          },
          "type": "array"
        },
        "pushable": {
          "description": "Whether the control can be pressed.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind",
        "location",
        "positions",
        "pushable",
        "assignable",
        "connection_ids"
      ],
      "type": "object"
    },
    "BodyControls": {
      "additionalProperties": false,
      "description": "Physical controls documented for a body.",
      "properties": {
        "analog_levels": {
          "description": "Number of analog sample levels exposed by the controls.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "controls": {
          "additionalProperties": {
            "$ref": "#/$defs/BodyControl"
          },
          "description": "Physical controls keyed by stable control identity.",
          "type": "object"
        },
        "manual": {
          "$ref": "#/$defs/ManualReference",
          "description": "Published manual identifying the physical controls."
        }
      },
      "required": [
        "manual",
        "analog_levels",
        "controls"
      ],
      "type": "object"
    },
    "BodyHardware": {
      "additionalProperties": false,
      "description": "Additional body-specific physical wiring.",
      "properties": {
        "gpio_feedback": {
          "description": "Connections between GPIO output and input pads.",
          "items": {
            "$ref": "#/$defs/GpioFeedback"
          },
          "type": "array"
        },
        "keypad_samples": {
          "additionalProperties": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "description": "Named keypad positions and their declared analog sample levels.",
          "type": "object"
        },
        "serial_attachments": {
          "description": "Serial endpoints and their processor-side connections.",
          "items": {
            "$ref": "#/$defs/SerialAttachment"
          },
          "type": "array"
        },
        "thermal_connection_ids": {
          "description": "Body connections carrying thermal sensor voltages.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "serial_attachments",
        "gpio_feedback",
        "keypad_samples",
        "thermal_connection_ids"
      ],
      "type": "object"
    },
    "BodyRamRegion": {
      "additionalProperties": false,
      "description": "A body-specific mapped RAM extent.",
      "properties": {
        "base": {
          "description": "Physical base address of the region.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "bytes": {
          "description": "Region capacity in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "Stable region identity within the body.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MemoryKind",
          "description": "Memory type exposed by the body."
        }
      },
      "required": [
        "id",
        "base",
        "bytes",
        "kind"
      ],
      "type": "object"
    },
    "BodyWiring": {
      "additionalProperties": false,
      "description": "A physical wire between a body connection, part, or SoC block.",
      "properties": {
        "signal": {
          "$ref": "#/$defs/WireSignal",
          "description": "Named signal carried by the wire."
        },
        "source_id": {
          "description": "Source component identity.",
          "type": "string"
        },
        "target_id": {
          "description": "Target component identity.",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "target_id",
        "signal"
      ],
      "type": "object"
    },
    "CardSlotAssembly": {
      "additionalProperties": false,
      "description": "A body-specific attachment for a removable-card slot part.",
      "properties": {
        "connection_id": {
          "description": "Body connection identity for the card data interface.",
          "type": "string"
        },
        "controller_id": {
          "description": "SoC removable-card controller block, when implemented.",
          "type": [
            "string",
            "null"
          ]
        },
        "detect_connection_id": {
          "description": "Body connection identity carrying card-detect state.",
          "type": "string"
        },
        "part_id": {
          "description": "Reusable card-slot part identity.",
          "type": "string"
        },
        "write_protect_connection_id": {
          "description": "Body connection identity carrying write-protect state.",
          "type": "string"
        }
      },
      "required": [
        "part_id",
        "connection_id",
        "detect_connection_id",
        "write_protect_connection_id"
      ],
      "type": "object"
    },
    "ConnectionKind": {
      "description": "Physical connection categories.",
      "oneOf": [
        {
          "const": "control",
          "description": "User button or control switch.",
          "type": "string"
        },
        {
          "const": "usb",
          "description": "USB cable or host connection.",
          "type": "string"
        },
        {
          "const": "hdmi",
          "description": "HDMI cable or display connection.",
          "type": "string"
        },
        {
          "const": "sd-card",
          "description": "SD card slot.",
          "type": "string"
        },
        {
          "const": "remote",
          "description": "Wired remote or microphone connector.",
          "type": "string"
        },
        {
          "const": "hot-shoe",
          "description": "Hot-shoe accessory connector.",
          "type": "string"
        },
        {
          "const": "external-power",
          "description": "External power connector.",
          "type": "string"
        },
        {
          "const": "battery-door",
          "description": "Battery-door interlock.",
          "type": "string"
        },
        {
          "const": "sensor",
          "description": "Sensor data or control connection.",
          "type": "string"
        },
        {
          "const": "lens",
          "description": "Lens or actuator connection.",
          "type": "string"
        },
        {
          "const": "display",
          "description": "Display data or control connection.",
          "type": "string"
        },
        {
          "const": "microcontroller",
          "description": "Microcontroller connection.",
          "type": "string"
        },
        {
          "const": "power-control",
          "description": "Serial power-control endpoint.",
          "type": "string"
        }
      ]
    },
    "ConnectionSignal": {
      "description": "One electrical signal exposed by a body connection.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A GPIO pin with an active logic level.",
          "properties": {
            "active_level": {
              "type": "boolean"
            },
            "kind": {
              "const": "gpio",
              "type": "string"
            },
            "pin": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "port": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "port",
            "pin",
            "active_level"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An ADC channel and threshold.",
          "properties": {
            "channel": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "adc",
              "type": "string"
            },
            "threshold": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "channel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A named SoC block signal.",
          "properties": {
            "block_id": {
              "type": "string"
            },
            "kind": {
              "const": "block",
              "type": "string"
            },
            "signal": {
              "$ref": "#/$defs/BlockSignal"
            }
          },
          "required": [
            "kind",
            "block_id",
            "signal"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A routed serial control channel.",
          "properties": {
            "address": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "block_id": {
              "type": "string"
            },
            "channel": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "serial",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "block_id",
            "channel",
            "address"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Direct interrupt wire to a processor interrupt-controller input.",
          "properties": {
            "controller_id": {
              "type": "string"
            },
            "kind": {
              "const": "interrupt",
              "type": "string"
            },
            "line": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "controller_id",
            "line"
          ],
          "type": "object"
        }
      ]
    },
    "ControlBusAttachment": {
      "additionalProperties": false,
      "description": "Control-bus route for one physical part installed in a camera body.",
      "properties": {
        "address": {
          "description": "Seven-bit endpoint address.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "channel": {
          "description": "Controller channel index.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "controller_id": {
          "description": "SoC control-bus block identity.",
          "type": "string"
        }
      },
      "required": [
        "controller_id",
        "channel",
        "address"
      ],
      "type": "object"
    },
    "ControlBusChip": {
      "additionalProperties": false,
      "description": "A physical control-bus device installed in a camera body.",
      "properties": {
        "address": {
          "description": "Seven-bit device address.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "channel": {
          "description": "Control-bus channel index.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "controller_id": {
          "description": "SoC control-bus block identity carrying this device.",
          "type": "string"
        },
        "polarity_selector": {
          "description": "Polarity selector for this device.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "controller_id",
        "channel",
        "address",
        "polarity_selector"
      ],
      "type": "object"
    },
    "ControlKind": {
      "description": "Physical control categories.",
      "oneOf": [
        {
          "const": "dial",
          "description": "Rotary dial with named positions.",
          "type": "string"
        },
        {
          "const": "button",
          "description": "Momentary button.",
          "type": "string"
        },
        {
          "const": "lever",
          "description": "Mechanical lever.",
          "type": "string"
        },
        {
          "const": "switch",
          "description": "Selector switch.",
          "type": "string"
        },
        {
          "const": "ring",
          "description": "Lens or body ring.",
          "type": "string"
        },
        {
          "const": "shutter",
          "description": "Two-stage shutter release.",
          "type": "string"
        },
        {
          "const": "wheel",
          "description": "Relative command wheel.",
          "type": "string"
        },
        {
          "const": "joystick",
          "description": "Directional selector.",
          "type": "string"
        },
        {
          "const": "touchscreen",
          "description": "Touch-sensitive display.",
          "type": "string"
        }
      ]
    },
    "ControlLocation": {
      "description": "Locations used to identify physical controls.",
      "oneOf": [
        {
          "const": "top",
          "description": "Top surface.",
          "type": "string"
        },
        {
          "const": "front",
          "description": "Front surface.",
          "type": "string"
        },
        {
          "const": "rear",
          "description": "Rear surface.",
          "type": "string"
        },
        {
          "const": "lens",
          "description": "Lens assembly.",
          "type": "string"
        },
        {
          "const": "bottom",
          "description": "Bottom surface.",
          "type": "string"
        }
      ]
    },
    "ControlPosition": {
      "additionalProperties": false,
      "description": "A named mechanical position of a physical control.",
      "properties": {
        "description": {
          "description": "Meaning of an icon or otherwise unlabeled position.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Stable position identity or printed value.",
          "type": "string"
        },
        "label": {
          "description": "Printed label when available.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "DisplayAssembly": {
      "additionalProperties": false,
      "description": "A body display assembly.",
      "properties": {
        "connection_id": {
          "description": "Body connection identity carrying display data.",
          "type": "string"
        },
        "part_id": {
          "description": "Reusable panel or display-controller part identity.",
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/SerialRoute"
            },
            {
              "type": "null"
            }
          ],
          "description": "Body-specific serial wiring for this panel."
        }
      },
      "required": [
        "part_id",
        "connection_id"
      ],
      "type": "object"
    },
    "FocusAxis": {
      "additionalProperties": false,
      "description": "A focus-axis model.",
      "properties": {
        "infinity_position": {
          "description": "Focus position representing infinity.",
          "format": "int32",
          "type": "integer"
        },
        "output": {
          "$ref": "#/$defs/OpticalQuantity",
          "description": "Named optical quantity produced by focus motion."
        },
        "steps_per_mm": {
          "description": "Focus steps per millimeter.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "output",
        "infinity_position",
        "steps_per_mm"
      ],
      "type": "object"
    },
    "GpioFeedback": {
      "additionalProperties": false,
      "description": "A declared electrical feedback connection between GPIO pads.",
      "properties": {
        "input_connection_id": {
          "description": "Body connection exposing the input pad.",
          "type": "string"
        },
        "output_connection_id": {
          "description": "Body connection exposing the output pad.",
          "type": "string"
        }
      },
      "required": [
        "output_connection_id",
        "input_connection_id"
      ],
      "type": "object"
    },
    "IrisOptics": {
      "additionalProperties": false,
      "description": "Aperture positions and their optical output.",
      "properties": {
        "output": {
          "$ref": "#/$defs/OpticalQuantity",
          "description": "Named optical quantity produced by the aperture."
        },
        "positions": {
          "description": "Aperture positions and their f-number values.",
          "items": {
            "$ref": "#/$defs/AperturePosition"
          },
          "type": "array"
        },
        "travel_limits": {
          "description": "Minimum and maximum mechanical positions.",
          "items": {
            "format": "int32",
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "output",
        "positions",
        "travel_limits"
      ],
      "type": "object"
    },
    "LensAssembly": {
      "additionalProperties": false,
      "description": "A body lens assembly.",
      "properties": {
        "connection_id": {
          "description": "Body connection identity carrying lens control signals.",
          "type": "string"
        },
        "encoder_connection_id": {
          "description": "Body connection wired to the optional rotary encoder.",
          "type": [
            "string",
            "null"
          ]
        },
        "focus": {
          "anyOf": [
            {
              "$ref": "#/$defs/FocusAxis"
            },
            {
              "type": "null"
            }
          ],
          "description": "Documented focus-axis response."
        },
        "home_connections": {
          "description": "Body connections wired to motor home switches.",
          "items": {
            "$ref": "#/$defs/LensHomeConnection"
          },
          "type": "array"
        },
        "iris": {
          "anyOf": [
            {
              "$ref": "#/$defs/IrisOptics"
            },
            {
              "type": "null"
            }
          ],
          "description": "Documented aperture positions and their optical output."
        },
        "part_id": {
          "description": "Reusable lens part identity.",
          "type": "string"
        },
        "pulse": {
          "$ref": "#/$defs/PulseInterface",
          "description": "Body-specific pulse-controller wiring for this lens."
        },
        "route": {
          "$ref": "#/$defs/SerialRoute",
          "description": "Body-specific serial route to the lens controller."
        }
      },
      "required": [
        "part_id",
        "connection_id",
        "route",
        "pulse",
        "home_connections"
      ],
      "type": "object"
    },
    "LensHomeConnection": {
      "additionalProperties": false,
      "description": "A body connection attached to one lens motor's home-switch input.",
      "properties": {
        "connection_id": {
          "description": "Body connection carrying the home-switch signal.",
          "type": "string"
        },
        "motor": {
          "description": "Motor index within the installed lens part.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "motor",
        "connection_id"
      ],
      "type": "object"
    },
    "ManualReference": {
      "additionalProperties": false,
      "description": "A published manual and the pages used to identify controls.",
      "properties": {
        "pages": {
          "description": "Referenced page numbers.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "title": {
          "description": "Manual title.",
          "type": "string"
        },
        "url": {
          "description": "Public manual URL.",
          "type": "string"
        }
      },
      "required": [
        "url",
        "title",
        "pages"
      ],
      "type": "object"
    },
    "MemoryKind": {
      "description": "Memory technologies exposed by the SoC.",
      "oneOf": [
        {
          "const": "dram",
          "description": "Dynamic random-access memory.",
          "type": "string"
        },
        {
          "const": "rom",
          "description": "Read-only boot memory.",
          "type": "string"
        },
        {
          "const": "sram",
          "description": "Static random-access memory.",
          "type": "string"
        },
        {
          "const": "tcm",
          "description": "Tightly coupled processor memory.",
          "type": "string"
        }
      ]
    },
    "MicrocontrollerAssembly": {
      "additionalProperties": false,
      "description": "A body-specific attachment for a microcontroller part.",
      "properties": {
        "channel": {
          "description": "Channel selected on the controller.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "connection_id": {
          "description": "Body connection identity carrying MCU signals.",
          "type": "string"
        },
        "controller_id": {
          "description": "SoC serial controller block identity.",
          "type": "string"
        },
        "part_id": {
          "description": "Reusable microcontroller part identity.",
          "type": "string"
        },
        "select_connection_id": {
          "description": "Body connection identity controlling chip select.",
          "type": "string"
        }
      },
      "required": [
        "part_id",
        "connection_id",
        "controller_id",
        "channel",
        "select_connection_id"
      ],
      "type": "object"
    },
    "NandGeometry": {
      "additionalProperties": false,
      "description": "NAND geometry installed in a camera body or storage part.",
      "properties": {
        "bytes": {
          "description": "Total main-area capacity in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "page_bytes": {
          "description": "Main-area page size in bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pages_per_block": {
          "description": "Pages per erase block.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "spare_bytes": {
          "description": "Spare-area size per page in bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
