  "$id": "https://fujimod.com/schemas/firmware.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A named firmware version and the content identities needed to run it.",
  "properties": {
    "$schema": {
      "const": "https://fujimod.com/schemas/firmware.schema.json",
      "description": "Stable schema identifier for this document.",
      "type": "string"
    },
    "body_id": {
      "description": "Body identity that carries this firmware.",
      "type": "string"
    },
    "boot_rom": {
      "anyOf": [
        {
          "$ref": "#/$defs/BootRomIdentity"
        },
        {
          "type": "null"
        }
      ],
