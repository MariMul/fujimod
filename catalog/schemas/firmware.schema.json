    },
    "id": {
      "description": "Stable firmware identity.",
      "type": "string"
    },
    "installation": {
      "anyOf": [
        {
          "$ref": "#/$defs/FirmwareInstallation"
        },
        {
          "type": "null"
        }
      ],
      "description": "Firmware installation and loader facts consumed by the emulator."
    },
    "schema": {
      "description": "Firmware record version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "update": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentIdentity"
        },
        {
          "type": "null"
        }
      ],
      "description": "Firmware update content, when distributed for this version."
    },
    "version": {
      "description": "Human-readable firmware version string.",
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "schema",
    "id",
    "body_id",
    "version"
  ],
  "title": "Firmware",
  "type": "object"
}
