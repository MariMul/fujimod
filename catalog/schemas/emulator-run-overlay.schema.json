{
  "$defs": {
    "RunBrowserCamera": {
      "additionalProperties": false,
      "description": "Browser camera attachments: a virtual card, still-capture policy and LCD preview cadence.",
      "properties": {
        "preview": {
          "$ref": "#/$defs/RunPreview",
          "description": "LCD preview statistics cadence."
        },
        "sensor": {
          "$ref": "#/$defs/RunBrowserSensor",
          "description": "The image sensor's scene input."
        },
        "still_capture": {
          "$ref": "#/$defs/RunStillCapture",
          "description": "Still-capture policy identity."
        },
        "virtual_card": {
          "$ref": "#/$defs/RunVirtualCard",
          "description": "Blank virtual card inserted into the declared card slot."
        }
      },
      "required": [
        "virtual_card",
        "still_capture",
        "preview",
        "sensor"
      ],
      "type": "object"
    },
    "RunBrowserSensor": {
      "additionalProperties": false,
      "description": "The browser's external scene input for the image sensor.",
      "properties": {
        "frames": {
          "description": "Identity of the run's scene asset that supplies the sensor's exposure input.",
          "type": "string"
        }
      },
      "required": [
        "frames"
      ],
      "type": "object"
    },
    "RunCardFilesystem": {
      "description": "Card filesystems a virtual card can declare.",
      "oneOf": [
        {
          "const": "fat32",
          "description": "FAT32 with the declared partition start and cluster size.",
          "type": "string"
        }
      ]
    },
    "RunEngine": {
      "description": "A supported processor execution backend.",
      "oneOf": [
        {
          "const": "unicorn",
          "description": "Run the configured processors through the Unicorn backend.",
          "type": "string"
        }
      ]
    },
    "RunExecution": {
      "additionalProperties": false,
      "description": "Execution policy selected by the run configuration.",
      "properties": {
        "engine": {
          "$ref": "#/$defs/RunEngine",
          "description": "CPU engine selected for the configured processors."
        },
        "instructions_per_tick": {
          "$ref": "#/$defs/RunInstructionRate",
          "description": "Instruction-derived virtual-time ratio."
        },
        "mode": {
          "$ref": "#/$defs/RunExecutionMode",
          "description": "Strictly model unsupported hardware and bus behavior."
        },
        "quantum": {
          "description": "Maximum instruction count scheduled in one batch.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "engine",
        "quantum",
        "instructions_per_tick"
      ],
      "type": "object"
    },
    "RunExecutionMode": {
      "description": "A supported run execution mode.",
      "oneOf": [
        {
          "const": "strict",
          "description": "Refuse unsupported hardware or bus behavior.",
          "type": "string"
        }
      ]
    },
    "RunInstructionRate": {
      "additionalProperties": false,
      "description": "Closed instruction-derived timebase ratio for a run.",
      "properties": {
        "denominator": {
          "description": "Board ticks advanced per instruction entry.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "numerator": {
          "description": "Instruction entries consumed per board tick.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "type": "object"
    },
    "RunOverlayChange": {
      "description": "The closed set of changes supported by run overlays.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Connect or disconnect the declared USB cable.",
          "properties": {
            "connected": {
              "type": "boolean"
            },
            "kind": {
              "const": "usb_connection",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "connected"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Select another named firmware entry.",
          "properties": {
            "kind": {
              "const": "start",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/RunStart"
            }
          },
          "required": [
            "kind",
            "start"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Select one named run operation.",
          "properties": {
            "kind": {
              "const": "purpose",
              "type": "string"
            },
            "purpose": {
              "$ref": "#/$defs/RunPurpose"
            }
          },
          "required": [
            "kind",
            "purpose"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Declare the execution policy for a run whose base configuration has none.",
          "properties": {
            "execution": {
              "$ref": "#/$defs/RunExecution"
            },
            "kind": {
              "const": "execution",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "execution"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Attach a virtual card, still-capture policy and preview cadence.",
          "properties": {
            "browser_camera": {
              "$ref": "#/$defs/RunBrowserCamera"
            },
            "kind": {
              "const": "browser_camera",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "browser_camera"
          ],
          "type": "object"
        }
      ]
    },
    "RunPreview": {
      "additionalProperties": false,
      "description": "LCD preview statistics cadence, in frames.",
      "properties": {
        "active_statistics_every_frames": {
          "description": "Statistics period while active: one through sixty frames.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "basis": {
          "description": "Declared basis for the cadence.",
          "type": "string"
        },
        "frames_per_second": {
          "description": "Preview frames per second: one through sixty.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "statistics_every_frames": {
          "description": "Statistics period while idle: one through sixty frames.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "statistics_profile": {
          "description": "Statistics divider profile identity.",
          "type": "string"
        }
      },
      "required": [
        "frames_per_second",
        "statistics_every_frames",
        "active_statistics_every_frames",
        "statistics_profile",
        "basis"
      ],
      "type": "object"
    },
    "RunPurpose": {
      "description": "Intended operation selected by a run configuration.",
      "oneOf": [
        {
          "const": "rom_boot",
          "description": "Start the selected firmware for normal operation.",
          "type": "string"
        },
        {
          "const": "service_session",
          "description": "Prepare a service-session run.",
          "type": "string"
        },
        {
          "const": "rehearsal",
          "description": "Prepare a rehearsal of a declared service operation.",
          "type": "string"
        },
        {
          "const": "boot_access",
          "description": "Prepare a boot-access probe.",
          "type": "string"
        },
        {
          "const": "shutdown",
          "description": "Prepare a controlled shutdown run.",
          "type": "string"
        }
      ]
    },
    "RunStart": {
      "description": "A supported firmware start entry.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Reset through the selected firmware's real boot ROM.",
          "properties": {
            "kind": {
              "const": "rom",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Enter through the selected firmware's loader entry.",
          "properties": {
            "kind": {
              "const": "loader",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Enter through a removable-card boot entry.",
          "properties": {
            "kind": {
              "const": "sd_card",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "RunStillCapture": {
      "description": "Still-capture policy identities a browser camera can select.",
      "oneOf": [
        {
          "const": "register-capture-readonly-card-observation",
          "description": "Register-level capture, observed read-only on the card.",
          "type": "string"
        }
      ]
    },
    "RunVirtualCard": {
      "additionalProperties": false,
      "description": "A virtual FAT card geometry declared for one browser camera.",
      "properties": {
        "filesystem": {
          "$ref": "#/$defs/RunCardFilesystem",
          "description": "Card filesystem."
        },
        "label": {
          "description": "FAT volume label: one to eleven ASCII bytes.",
          "type": "string"
        },
        "partition_start": {
          "description": "First sector of the FAT partition.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sectors": {
          "description": "Sectors on the blank card.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sectors_per_cluster": {
          "description": "Sectors per FAT cluster.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "filesystem",
        "label",
        "sectors",
        "partition_start",
        "sectors_per_cluster"
      ],
      "type": "object"
    }
  },
  "$id": "https://fujimod.com/schemas/emulator-run-overlay.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A named, typed change to one run configuration.",
  "properties": {
    "$schema": {
      "const": "https://fujimod.com/schemas/emulator-run-overlay.schema.json",
      "description": "Stable schema identifier for this document.",
      "type": "string"
    },
    "change": {
      "$ref": "#/$defs/RunOverlayChange",
      "description": "One typed run input change."
    },
    "configuration_id": {
      "description": "Run configuration this overlay applies to.",
      "type": "string"
    },
    "id": {
      "description": "Stable run-overlay identity.",
      "type": "string"
    },
    "schema": {
      "description": "Run-overlay document version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "$schema",
    "schema",
    "id",
    "configuration_id",
    "change"
  ],
  "title": "RunOverlay",
  "type": "object"
}
