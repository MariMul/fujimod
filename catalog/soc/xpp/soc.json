    "profiles": {
      "xpp": {
        "cpu_model": "Cortex-A7",
        "runtime_abi": "armv7a-unicorn-v1",
        "mmu": "Unicorn ARMv7-A CPU page-table walker; guest CP15 and page tables",
        "register_maps": {
          "gic": {
            "distributor": 4294905856,
            "cpu_interface": 4294909952,
            "lines": 512,
            "basis": "Kernel CBAR reads and GIC distributor/CPU-interface accesses at CBAR+0x1000/+0x2000. CBAR 0xffff0000 is a declared discovery input, not captured."
          },
          "interval_timer": {
            "base": 4294025216,
            "layout": "xpp",
            "routes": [
              {
                "channel": 0,
                "irq": 48
              },
              {
                "channel": 1,
                "irq": 49
              },
              {
                "channel": 2,
                "irq": 50
              },
              {
                "channel": 3,
                "irq": 51
              },
              {
                "channel": 4,
                "irq": 52
              },
              {
                "channel": 5,
                "irq": 53
              },
              {
                "channel": 6,
                "irq": 54
              },
              {
                "channel": 7,
                "irq": 55
              },
              {
                "channel": 8,
                "irq": 56
              },
              {
                "channel": 9,
                "irq": 57
              },
              {
                "channel": 10,
                "irq": 58
              },
              {
                "channel": 11,
                "irq": 59
              },
              {
                "channel": 12,
                "irq": 60
              },
              {
                "channel": 13,
                "irq": 61
              },
              {
                "channel": 14,
                "irq": 62
              },
              {
                "channel": 15,
                "irq": 63
              }
            ],
            "clock": "one timer cycle per aggregate CPU instruction; synthetic ratio, not measured",
            "basis": "Control +0 is written with an inverted select mask, per-channel configuration at +0x10+n*4, count and reload at +0x100+n*0x10; one channel is read as a running counter. Channel n raises interrupt 48+n: the X-T20 2.11 timer library (0xc4bcd0) maps channel n through byte table 0xed3b58 to row n+2 of interrupt descriptor table 0xed4720, whose first word is 0x30+n."
          },
          "flash_controller": {
            "base": 4294000640,
            "aperture": 4026531840,
            "size": 134217728,
            "irq_route": 35,
            "basis": "Flash reads go through the aperture at 0xf0000000+offset by CPU copies and DMA; the controller's configuration words are written around each copy. Commands: +0x00 opcode, +0x04 aperture address, +0x10 control (chip select in bits 6-7), +0x20 phase count, +0x1c start; +0x24 status and +0x28 mask, where a set mask bit also acknowledges its status. Page programs are aperture stores while the registers hold opcode 0x12, ended by +0x30 bit 0. X-T20 2.11 driver 0xc5182c/0xc5220c; its handler 0xc501c0 is connected through descriptor 0xed4804, interrupt 0x23."
          },
          "pl330": {
            "base": 4294017024,
            "irq_routes": [
              207,
              208,
              209,
              210,
              211,
              212,
              213,
              214
            ],
            "setup_ticks": 16,
            "bytes_per_tick": 16,
            "timing": "16 guest setup ticks plus ceil(bytes/16); functional transfer timing reused from XP4, not measured bus bandwidth.",
            "basis": "Channel programs start through DMAGO written to the debug instruction registers; the driver's IRQ table maps event n to line 207+n."
          },
          "serial_ports": {
            "bases": [
              4294082560,
              4294086656,
              4294090752,
              4294094848,
              4294098944,
              4294103040,
              4294107136
            ],
            "basis": "Declared discovery input: a provisional status law without a peer. Sends complete at once and set done bit 2, writes to +0x2c clear status bits, bit 3 reads set and received words read zero. The attached peers are not identified."
          },
          "decompressor": {
            "base": 4294443008,
            "irq_route": 129,
            "basis": "Method-4 streaming decompressor with the XP4 register interface: the X-T20 2.11 section-6 loader resets it through +0 (0xc5d584), waits for +0 to read nonzero and for +0x24 to read 0x10001, and connects interrupt descriptor row 0x12 of 0xed4720 (interrupt 0x81) with handler 0xc5d348 (0xc5d440)."
          }
        },
        "limits": [
          "Two cores are a declared discovery input from a public dual Cortex-A7 listing; the count is not measured.",
          "Storage covers the flash aperture, PL330 memory-to-memory programs and the method-4 decompressor; no display block is declared.",
          "No boot ROM, reset-release controller or external peripheral replies are assumed."
        ],
        "cache_basis": "Declared discovery input: the XP4 Cortex-A7 capacities, unmeasured. Not a cache timing model."
      }
    }
