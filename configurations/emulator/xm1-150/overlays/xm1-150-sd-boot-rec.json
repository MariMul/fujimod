{
  "$schema": "https://fujimod.com/schemas/emulator-run-overlay.schema.json",
  "schema": 1,
  "id": "xm1-150-sd-boot-rec",
  "configuration_id": "xm1-150",
  "change": {
    "kind": "preset",
    "preset": {
      "factory_options": {
        "storage_profile": "erased",
        "settings": "default",
        "clock_seconds_2000": 820540800,
        "rectangle_profile": "xm1-150-declared-luma-rectangle-overlay-unmeasured",
        "sd_card_profile": "declared-blank-sdhc-default-speed-unmeasured",
        "sd_card_present": true,
        "sd_card_format": {
          "label": "CAMERA",
          "partition_start": 8192,
          "sectors_per_cluster": 64
        }
      },
      "execution_scope": "emulator-only",
      "purpose": "rom_boot",
      "start": {
        "kind": "sd_card"
      },
      "clear_options": [
        "mcu_profile",
        "user_journals"
      ],
      "hardware_selection": {
        "soc_profile_id": "exr2-service-transports",
        "body_profile_id": "xm1-rec"
      },
      "hardware_inputs_id": "xm1-rec",
      "firmware_profile_id": "xm1-150"
    }
  }
}
