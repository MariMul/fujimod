{
  "$schema": "https://fujimod.com/schemas/emulator-run-overlay.schema.json",
  "schema": 1,
  "id": "x100s-121-sd-boot-rec",
  "configuration_id": "x100s-121",
  "change": {
    "kind": "preset",
    "preset": {
      "factory_options": {
        "storage_profile": "erased",
        "settings": "default",
        "clock_seconds_2000": 820540800,
        "rectangle_profile": "exr2-signed-ycbcr-rectangle-overlay-unmeasured",
        "sd_card_profile": "declared-blank-sdhc-default-speed-unmeasured",
        "sd_card_present": true
      },
      "execution_scope": "emulator-only",
      "purpose": "rom_boot",
      "start": {
        "kind": "sd_card"
      },
      "clear_options": [
        "mcu_profile",
        "user_journals"
      ]
    }
  }
}
