{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fujimod-usb-sharing",
  "account_id": "1edee8e500839ee3dbf7338f44503075",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "routes": [{ "pattern": "share.fujimod.com", "custom_domain": true }],
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "ISSUES", "class_name": "IssueReports" },
      { "name": "ROOMS", "class_name": "ShareRoom" },
      { "name": "TURN_BUDGET", "class_name": "TurnBudget" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ShareRoom", "TurnBudget"] },
    { "tag": "v2", "new_sqlite_classes": ["IssueReports"] },
  ],
  "r2_buckets": [{ "binding": "ISSUE_REPORTS", "bucket_name": "fujimod-issue-reports" }],
  "ratelimits": [
    { "name": "ISSUE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "CONNECTIONS", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://fujimod.com,https://www.fujimod.com",
    "TURN_TTL_SECONDS": "86400",
    "TURN_DAILY_ISSUE_LIMIT": "50",
  },
}
