{
  "name": "fujimod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "vp check --no-fmt && vp build && node scripts/verify-models.mjs dist",
    "preview": "vp preview --host 127.0.0.1",
    "test": "vp test run",
    "prepare:release": "node scripts/prepare-pages.mjs",
    "build:local-preview": "vp check --no-fmt && vp build --mode local-preview && node scripts/verify-models.mjs dist-local-preview",
    "test:watch": "vp test",
    "check": "vp check --no-fmt",
    "lint": "vp lint",
    "format": "vp fmt",
    "docs:solid": "node scripts/fetch-solid-docs.mjs",
    "format:check": "vp fmt --check"
  },
  "dependencies": {
    "solid-js": "^1.9.17",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint-plugin-solid": "0.18.1",
    "jsdom": "30.1.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plugin-solid": "2.11.14",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "$vite"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
