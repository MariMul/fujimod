{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "settings_section",
  "description": "Qualification fixture; exercises the intended settings memory model, not a released card schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "hold_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 2000,
      "default": 400,
      "js2cType": "uint32_t"
    },
    "theme": {
      "type": "string",
      "enum": [
        "default",
        "classic",
        "night"
      ],
      "default": "default"
    },
    "author": {
      "type": "string",
      "maxLength": 32,
      "default": ""
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repeat_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 300,
          "js2cType": "uint32_t"
        }
      }
    },
    "points": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255,
        "js2cType": "uint32_t"
      }
    }
  }
}
